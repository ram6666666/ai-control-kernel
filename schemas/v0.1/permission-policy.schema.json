{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-control-kernel/schemas/v0.1/permission-policy.schema.json",
  "title": "AI Control Kernel Permission Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "status", "predicate_registry", "condition_registry", "combination_rules", "base_by_operation", "condition_overrides", "semantic_review"],
  "properties": {
    "schema_version": {"const": "ack.permission_policy.v0.1"},
    "policy_id": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "predicate_registry": {"type": "string", "minLength": 1},
    "condition_registry": {"type": "string", "minLength": 1},
    "combination_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_operation", "unknown_condition_code", "semantic_condition_precedence", "mechanical_condition_merge", "decision_order", "predicate_failure", "empty_condition_set_uses_base"],
      "properties": {
        "unknown_operation": {"enum": ["SEMANTIC_REVIEW_REQUIRED", "DENY"]},
        "unknown_condition_code": {"const": "DENY"},
        "semantic_condition_precedence": {"const": "BEFORE_MECHANICAL_PERMISSION"},
        "mechanical_condition_merge": {"const": "MOST_RESTRICTIVE"},
        "decision_order": {"type": "array", "items": {"enum": ["DENY", "SEMANTIC_REVIEW_REQUIRED", "ALLOW", "NOOP_IDEMPOTENT"]}, "uniqueItems": true},
        "predicate_failure": {"const": "DENY"},
        "empty_condition_set_uses_base": {"const": true}
      }
    },
    "base_by_operation": {
      "type": "object",
      "required": ["READ_DIAGNOSE", "DISCUSS_PLAN", "SHADOW_VALIDATE", "WRITE_DIAGNOSTIC_EVIDENCE", "PRODUCE_NONCANONICAL_WORKING_ARTIFACT", "CLAIM_EXECUTION_UNIT", "EXECUTE_AND_CHECKPOINT", "PUBLISH_AUTHORITATIVE_ARTIFACT", "ISSUE_INDEPENDENT_AUDIT_VERDICT", "MUTATE_CONTROL_STATE", "PROMOTE_OR_ACCEPT_CANONICAL", "LIVENESS_REPAIR", "POLICY_RECONCILIATION"],
      "additionalProperties": {"$ref": "#/$defs/RiskRules"}
    },
    "condition_overrides": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/ConditionOverride"}
    },
    "semantic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codes", "when_relevant_to_requested_authority_effect", "authority_effect_allowed_while_unresolved", "no_authority_effect_operations_allowed"],
      "properties": {
        "codes": {"type": "array", "minItems": 1, "items": {"enum": ["S_AUTHORITY_MEANING_AMBIGUOUS", "S_SCOPE_CHANGE_AMBIGUOUS", "S_REQUIREMENT_CONFLICT", "S_ACCEPTANCE_JUDGMENT_REQUIRED"]}, "uniqueItems": true},
        "when_relevant_to_requested_authority_effect": {"const": "SEMANTIC_REVIEW_REQUIRED"},
        "authority_effect_allowed_while_unresolved": {"const": false},
        "no_authority_effect_operations_allowed": {"type": "array", "items": {"enum": ["READ_DIAGNOSE", "DISCUSS_PLAN"]}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "DecisionResult": {"enum": ["ALLOW", "DENY", "NOOP_IDEMPOTENT"]},
    "EffectScope": {"enum": ["NONE", "READ_ONLY", "NO_AUTHORITY_EFFECT", "SHADOW_ONLY", "DIAGNOSTIC_ONLY", "NONCANONICAL_ONLY", "CLAIM_ONLY", "BOUNDED_EXECUTION", "AUTHORITATIVE_PUBLICATION", "AUDIT_VERDICT_ONLY", "DECLARED_STATE_FIELDS_ONLY", "CANONICAL_PROMOTION", "LIVENESS_ONLY", "POLICY_RECONCILIATION_ONLY", "RECOVERY_ONLY"]},
    "DecisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "effect_scope"],
      "properties": {
        "mode": {"enum": ["DIRECT", "PREDICATE_GATE"]},
        "result": {"$ref": "#/$defs/DecisionResult"},
        "predicates": {"type": "array", "items": {"pattern": "^P_[A-Z0-9_]+$"}, "uniqueItems": true},
        "on_pass": {"$ref": "#/$defs/DecisionResult"},
        "on_fail": {"const": "DENY"},
        "effect_scope": {"$ref": "#/$defs/EffectScope"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "DIRECT"}}}, "then": {"required": ["result"], "not": {"anyOf": [{"required": ["predicates"]}, {"required": ["on_pass"]}, {"required": ["on_fail"]}]}}},
        {"if": {"properties": {"mode": {"const": "PREDICATE_GATE"}}}, "then": {"required": ["predicates", "on_pass", "on_fail"], "not": {"required": ["result"]}}}
      ]
    },
    "RiskRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GREEN", "AMBER", "RED"],
      "properties": {
        "GREEN": {"$ref": "#/$defs/DecisionRule"},
        "AMBER": {"$ref": "#/$defs/DecisionRule"},
        "RED": {"$ref": "#/$defs/DecisionRule"}
      }
    },
    "ConditionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "operation_overrides"],
      "properties": {
        "risk": {"enum": ["AMBER", "RED"]},
        "operation_overrides": {"type": "object", "additionalProperties": {"$ref": "#/$defs/DecisionRule"}}
      }
    }
  }
}
