{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-control-kernel:schema:state-machine:v0.1",
  "title": "AI Control Kernel State Machine v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "machine_id", "status", "owner_class", "predicate_registry", "normalized_states", "rules", "terminal_states", "unknown_state_policy", "extension_contract"],
  "properties": {
    "schema_version": {"const": "ack.state_machine.v0.1"},
    "machine_id": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "owner_class": {"type": "string", "minLength": 1},
    "predicate_registry": {"type": "string", "minLength": 1},
    "normalized_states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TransitionRule"}},
    "terminal_states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unknown_state_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_state", "ordinary_transition_allowed", "allowed_operations"],
      "properties": {
        "normalized_state": {"const": "UNKNOWN"},
        "ordinary_transition_allowed": {"const": false},
        "allowed_operations": {"type": "array", "items": {"enum": ["READ_DIAGNOSE", "DISCUSS_PLAN", "SHADOW_VALIDATE"]}, "uniqueItems": true}
      }
    },
    "extension_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_required", "version_required", "owner_class_required", "may_add_raw_states", "may_add_explicit_edges", "may_narrow_core_edge", "may_broaden_core_prohibition", "fuzzy_inference_forbidden"],
      "properties": {
        "namespace_required": {"const": true},
        "version_required": {"const": true},
        "owner_class_required": {"const": true},
        "may_add_raw_states": {"const": true},
        "may_add_explicit_edges": {"const": true},
        "may_narrow_core_edge": {"const": true},
        "may_broaden_core_prohibition": {"const": false},
        "fuzzy_inference_forbidden": {"const": true}
      }
    }
  },
  "$defs": {
    "TransitionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "to", "operation_class", "writer_owner", "require_predicates"],
      "oneOf": [{"required": ["from"]}, {"required": ["from_set"]}],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "string"},
        "from_set": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "to": {"type": "string", "minLength": 1},
        "operation_class": {"type": "string", "minLength": 1},
        "writer_owner": {"type": "string", "minLength": 1},
        "require_predicates": {"type": "array", "items": {"pattern": "^P_[A-Z0-9_]+$"}, "uniqueItems": true},
        "evidence_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
