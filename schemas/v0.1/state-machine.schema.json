{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-control-kernel/schemas/v0.1/state-machine.schema.json",
  "title": "AI Control Kernel State Machine v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "machine_id", "status", "owner_class", "normalized_states", "rules", "terminal_states", "unknown_state_policy", "extension_contract"],
  "properties": {
    "schema_version": {"const": "ack.state_machine.v0.1"},
    "machine_id": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "owner_class": {"type": "string", "minLength": 1},
    "normalized_states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TransitionRule"}},
    "terminal_states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unknown_state_policy": {"type": "object"},
    "extension_contract": {"type": "object"}
  },
  "$defs": {
    "TransitionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "to", "operation_class", "writer_owner", "require_predicates"],
      "oneOf": [
        {"required": ["from"]},
        {"required": ["from_set"]}
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "string"},
        "from_set": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "to": {"type": "string", "minLength": 1},
        "operation_class": {"type": "string", "minLength": 1},
        "writer_owner": {"type": "string", "minLength": 1},
        "require_predicates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
